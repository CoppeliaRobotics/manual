name: sim.setVector2Property
description: Sets a vector2 property (double[2])
luaSynopsis: sim.setVector2Property(int target, string propertyName, list propertyState, dict options = {})
pythonSynopsis: sim.setVector2Property(int target, string propertyName, float[2] propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
