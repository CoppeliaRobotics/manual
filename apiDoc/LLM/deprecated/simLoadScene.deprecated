name: sim.loadScene
description: Loads a previously saved scene
luaSynopsis: sim.loadScene(string/bytes filenameOrBuffer)
pythonSynopsis: sim.loadScene(string/buffer filenameOrBuffer)
inputs:
1. filename: scene buffer or scene filename, including extension. An empty string loads the default scene. By default, the current scene is overwritten (append "@keepCurrent" to the filename to preserve current scene). An empty string loads the default scene
outputs:
replacedBy:
- name: loadScene, class: app, file: app_loadScene.method
- name: loadSceneFromBuffer, class: app, file: app_loadSceneFromBuffer.method
