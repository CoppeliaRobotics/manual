name: sim.setLightParameters
description: Deprecated. See properties instead
luaSynopsis: sim.setLightParameters(int objectHandle, int state, None, list diffusePart, list specularPart)
pythonSynopsis: sim.setLightParameters(int objectHandle, int state, nil, float[3] diffusePart, float[3] specularPart)
inputs:
1. objectHandle: handle of the light
2. state: bit-coded:
    - bit0 is set (1): light on
3. diffusePart: red, green and blue component of the light's diffuse part. Can be None/nil
4. specularPart: red, green and blue component of the light's specular part. Can be None/nil
outputs:
replacedBy:
- name: enabled, class: light, file: light_enabled.property
- name: lightColor.diffuse, class: light, file: lightColor_diffuse.property
- name: lightColor.specular, class: light, file: lightColor_specular.property
- name: lightColor.emission, class: light, file: lightColor_emission.property
