name: sim.generateTextShape
description: Generates a 3D text model.
luaSynopsis: int modelHandle = sim.generateTextShape(string txt, list color = [1, 1, 1], float height = 0.1, bool centered = False, string alphabetLocation = None)
pythonSynopsis: int modelHandle = sim.generateTextShape(string txt, float[3] color = {1, 1, 1}, float height = 0.1, bool centered = false, string alphabetLocation = nil)
inputs:
1. txt: the text string
2. color: the text color. Optional
3. height: the height of the text. Optional
4. centered: whether the text should be centered. Optional
5. alphabetLocation: the path to an alphabet model. Optional
outputs:
1. modelHandle: handle of the generated model
replacedBy:
- name: createObject, class: scene, file: scene_createObject.method