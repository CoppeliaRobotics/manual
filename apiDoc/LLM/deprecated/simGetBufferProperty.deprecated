name: sim.getBufferProperty
description: Fetches a buffer property
luaSynopsis: bytes propertyState = sim.getBufferProperty(int target, string propertyName, dict options = {})
pythonSynopsis: buffer propertyState = sim.getBufferProperty(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
replacedBy:
- name: getBufferProperty, class: object, file: object_getBufferProperty.method
