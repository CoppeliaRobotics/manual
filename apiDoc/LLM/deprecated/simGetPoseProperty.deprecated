name: sim.getPoseProperty
description: Fetches a pose property (double[7]: x, y, z, qx, qy, qz, qw)
luaSynopsis: list propertyState = sim.getPoseProperty(int target, string propertyName, dict options = {})
pythonSynopsis: float[7] propertyState = sim.getPoseProperty(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
