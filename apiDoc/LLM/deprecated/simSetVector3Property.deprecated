name: sim.setVector3Property
description: Sets a vector3 property (double[3])
luaSynopsis: sim.setVector3Property(int target, string propertyName, list propertyState, dict options = {})
pythonSynopsis: sim.setVector3Property(int target, string propertyName, float[3] propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
replacedBy:
- name: setVector3Property, class: object, file: object_setVector3Property.method
