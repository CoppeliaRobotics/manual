name: sim.setJointPosition
description: Sets the linear/angular position of a joint. Cannot be used with spherical joints (use sim.setObjectChildPose instead)
luaSynopsis: sim.setJointPosition(int objectHandle, float position)
pythonSynopsis: sim.setJointPosition(int objectHandle, float position)
inputs:
1. objectHandle: handle of the joint object
2. position: linear/angular position of the joint
outputs:
replacedBy:
- name: joint.position, class: joint, file: joint_joint_position.property
