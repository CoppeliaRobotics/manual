name: sim.getQuaternionProperty
description: Fetches a quaternion property (double[4]: qx, qy, qz, qw)
luaSynopsis: list propertyState = sim.getQuaternionProperty(int target, string propertyName, dict options = {})
pythonSynopsis: float[4] propertyState = sim.getQuaternionProperty(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
replacedBy:
- name: getQuaternionProperty, class: object, file: object_getQuaternionProperty.method
