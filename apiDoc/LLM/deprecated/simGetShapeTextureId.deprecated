name: sim.getShapeTextureId
description: Retrieves the texture ID of a texture that is applied to a specific shape
luaSynopsis: int textureId = sim.getShapeTextureId(int shapeHandle)
pythonSynopsis: int textureId = sim.getShapeTextureId(int shapeHandle)
inputs:
1. shapeHandle: handle of the shape.
outputs:
1. textureId: texture ID, or -1 if texture does not exist
replacedBy:
- name: texture.id, class: mesh, file: mesh_texture_id.property
