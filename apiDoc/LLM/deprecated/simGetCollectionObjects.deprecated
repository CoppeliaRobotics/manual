name: sim.getCollectionObjects
description: Retrieves the object handles that compose a collection
luaSynopsis: list objectHandles = sim.getCollectionObjects(int collectionHandle)
pythonSynopsis: int[] objectHandles = sim.getCollectionObjects(int collectionHandle)
inputs:
1. collectionHandle: handle of the collection
outputs:
1. objectHandles: array of n object handles
replacedBy:
- name: objects, class: collection, file: collection_objects.property
