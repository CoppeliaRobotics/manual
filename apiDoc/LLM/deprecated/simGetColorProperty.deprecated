name: sim.getColorProperty
description: Fetches a color property (float[3])
luaSynopsis: list propertyState = sim.getColorProperty(int target, string propertyName, dict options = {})
pythonSynopsis: float[3] propertyState = sim.getColorProperty(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
replacedBy:
- name: getColorProperty, class: object, file: object_getColorProperty.method
