name: sim.initScript
description: Initializes/reinitializes a script. Operates in an asynchronous way, and cannot be called from within the script being reinitialized
luaSynopsis: sim.initScript(int scriptHandle)
pythonSynopsis: sim.initScript(int scriptHandle)
inputs:
1. scriptHandle: handle of the script to initialize/reinitialize
outputs:
replacedBy:
- name: init, class: detachedScript, file: detachedScript_init.method
