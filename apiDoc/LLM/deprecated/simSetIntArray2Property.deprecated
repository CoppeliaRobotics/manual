name: sim.setIntArray2Property
description: Sets an int[2] property
luaSynopsis: sim.setIntArray2Property(int target, string propertyName, list propertyState, dict options = {})
pythonSynopsis: sim.setIntArray2Property(int target, string propertyName, int[2] propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
replacedBy:
- name: setIntArrayProperty, class: object, file: object_setIntArrayProperty.method
