name: sim.setStringProperty
description: Sets a string property (text)
luaSynopsis: sim.setStringProperty(int target, string propertyName, string propertyState, dict options = {})
pythonSynopsis: sim.setStringProperty(int target, string propertyName, string propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
replacedBy:
- name: setStringProperty, class: object, file: object_setStringProperty.method
