name: sim.setPoseProperty
description: Sets a pose property (double[7]: x, y, z, qx, qy, qz, qw)
luaSynopsis: sim.setPoseProperty(int target, string propertyName, list propertyState, dict options = {})
pythonSynopsis: sim.setPoseProperty(int target, string propertyName, float[7] propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
replacedBy:
- name: setPoseProperty, class: object, file: object_setPoseProperty.method
