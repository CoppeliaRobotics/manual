name: sim.getPropertyName
description: Fetches the name of a property, based on an index
luaSynopsis: string propertyName = sim.getPropertyName(int target, int index, dict options = {})
pythonSynopsis: string propertyName = sim.getPropertyName(int target, int index, map options = {})
inputs:
1. target: target item
2. index: property index
3. options: an optional map. Set options.prefix to perform an initial filtering based on a prefix
outputs:
1. propertyName: property name
replacedBy:
- name: getPropertyName, class: object, file: object_getPropertyName.method
