name: sim.getJointTargetPosition
description: Retrieves the target linear/angular position of a joint
luaSynopsis: float targetPosition = sim.getJointTargetPosition(int objectHandle)
pythonSynopsis: float targetPosition = sim.getJointTargetPosition(int objectHandle)
inputs:
1. objectHandle: handle of the joint object
outputs:
1. targetPosition: target position of the joint
replacedBy:
- name: targetPosition, class: joint, file: joint_targetPosition.property
