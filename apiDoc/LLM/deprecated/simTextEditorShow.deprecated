name: sim.textEditorShow
description: Shows or hides a text edition window previously opened with sim.textEditorOpen
luaSynopsis: sim.textEditorShow(int handle, bool showState)
pythonSynopsis: sim.textEditorShow(int handle, bool showState)
inputs:
1. handle: handle of the text editor window
2. showState: desired show state of the text editor window
outputs:
replacedBy:
- name: visible, class: TextEditor, file: TextEditor_visible.property
