name: sim.createJoint
description: Creates a joint
luaSynopsis: int jointHandle = sim.createJoint(int jointType, int jointMode, int options, list sizes = None)
pythonSynopsis: int jointHandle = sim.createJoint(int jointType, int jointMode, int options, float[2] sizes = nil)
inputs:
1. jointType:
    - sim.joint_revolute
    - sim.joint_prismatic
    - sim.joint_spherical
2. jointMode: a joint mode
3. options: reserved. Set to 0
4. sizes: array of 2 values indicating the joint length and diameter. Can be None/nil for default values
outputs:
1. jointHandle: handle of the joint
replacedBy:
- name: createObject, class: app, file: app_createObject.method
- name: createObject, class: scene, file: scene_createObject.method
