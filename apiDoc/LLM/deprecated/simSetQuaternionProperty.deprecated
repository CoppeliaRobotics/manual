name: sim.setQuaternionProperty
description: Sets a quaternion property (double[4]: qx, qy, qz, qw)
luaSynopsis: sim.setQuaternionProperty(int target, string propertyName, list propertyState, dict options = {})
pythonSynopsis: sim.setQuaternionProperty(int target, string propertyName, float[4] propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
