name: sim.textEditorOpen
description: Opens a text edition window
luaSynopsis: int handle = sim.textEditorOpen(string initText, string properties)
pythonSynopsis: int handle = sim.textEditorOpen(string initText, string properties)
inputs:
1. initText: initial text to be displayed.
2. xml: XML description of the text editor's properties. Can be an empty string for default properties
outputs:
1. handle: handle of the text editor
replacedBy:
- name: Constructor, class: TextEditor, file: TextEditor_Constructor.method
