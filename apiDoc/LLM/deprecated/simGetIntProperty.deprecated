name: sim.getIntProperty
description: Fetches an int32 property
luaSynopsis: int propertyState = sim.getIntProperty(int target, string propertyName, dict options = {})
pythonSynopsis: int propertyState = sim.getIntProperty(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
replacedBy:
- name: getIntProperty, class: object, file: object_getIntProperty.method
