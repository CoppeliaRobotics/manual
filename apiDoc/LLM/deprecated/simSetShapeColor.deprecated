name: sim.setShapeColor
description: Sets the color of a shape
luaSynopsis: sim.setShapeColor(int shapeHandle, string colorName, int colorComponent, list rgbData)
pythonSynopsis: sim.setShapeColor(int shapeHandle, string colorName, int colorComponent, float[3] rgbData)
inputs:
1. shapeHandle: handle of the shape
2. colorName: name of a color. Can be an empty string, but if a name is provided, only shapes (or sub-entities of them) with a same color name will be modified. If colorName is @compound, then all individual colors of a compound shape can be set at once
3. colorComponent: color component
4. rgbData: red, green and blue components of the color (3 values), or the transparency value (1 value)
outputs:
replacedBy:
- name: color.diffuse, class: mesh, file: mesh_color_diffuse.property
- name: color.emission, class: mesh, file: mesh_color_emission.property
- name: color.specular, class: mesh, file: mesh_color_specular.property
- name: color.transparency, class: mesh, file: mesh_color_transparency.property
- name: applyColor.diffuse, class: shape, file: shape_applyColor_diffuse.property
- name: applyColor.emission, class: shape, file: shape_applyColor_emission.property
- name: applyColor.specular, class: shape, file: shape_applyColor_specular.property
- name: applyColor.transparency, class: shape, file: shape_applyColor_transparency.property
- name: compoundColors.diffuse, class: shape, file: shape_compoundColors_diffuse.property
- name: compoundColors.emission, class: shape, file: shape_compoundColors_emission.property
- name: compoundColors.specular, class: shape, file: shape_compoundColors_specular.property
- name: compoundColors.transparency, class: shape, file: shape_compoundColors_transparency.property
