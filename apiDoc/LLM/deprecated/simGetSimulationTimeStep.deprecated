name: sim.getSimulationTimeStep
description: Retrieves the simulation time step (the simulation time (i.e. not real-time) that passes at each main script simulation pass). This value might not be constant for a given simulation.
luaSynopsis: float timeStep = sim.getSimulationTimeStep()
pythonSynopsis: float timeStep = sim.getSimulationTimeStep()
inputs:
outputs:
1. timeStep: simulation time step
replacedBy:
- name: simulation.timeStep, class: scene, file: scene_simulation_timeStep.property
