name: sim.setScriptInt32Param
description: Deprecated. Use sim.setObjectInt32Param instead
luaSynopsis: sim.setScriptInt32Param(int scriptHandle, int parameterID, int parameter)
pythonSynopsis: sim.setScriptInt32Param(int scriptHandle, int parameterID, int parameter)
inputs:
1. scriptHandle: handle of the script, or sim.handle_self
2. parameterID: identifier of the parameter to set. See the list of all possible script parameters
3. parameter: parameter value
outputs:
replacedBy:
- name: autoYieldDelay, class: detachedScript, file: detachedScript_autoYieldDelay.property
- name: enabled, class: detachedScript, file: detachedScript_enabled.property
- name: execPriority, class: detachedScript, file: detachedScript_execPriority.property
- name: restartOnError, class: detachedScript, file: detachedScript_restartOnError.property
