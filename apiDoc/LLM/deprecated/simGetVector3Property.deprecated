name: sim.getVector3Property
description: Fetches a vector3 property (double[3])
luaSynopsis: list propertyState = sim.getVector3Property(int target, string propertyName, dict options = {})
pythonSynopsis: float[3] propertyState = sim.getVector3Property(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
replacedBy:
- name: getVector3Property, class: object, file: object_getVector3Property.method
