name: sim.createScript
description: Creates a script object.
luaSynopsis: int scriptHandle = sim.createScript(int scriptType, string scriptText, int options = 0 string lang = 'lua')
pythonSynopsis: int scriptHandle = sim.createScript(int scriptType, string scriptText, int options = 0 string lang = 'lua')
inputs:
1. scriptType: the script type. Only simulation-, customization- or passive scripts are allowed
2. scriptText: the content of the script
3. options: bit-coded options:
    - bit 0 set (1): script is initially disabled
4. lang: language. A value different 'lua' or 'python' disables the script
outputs:
1. scriptHandle: handle of the script object
replacedBy:
- name: createObject, class: app, file: app_createObject.method
- name: createObject, class: scene, file: scene_createObject.method
