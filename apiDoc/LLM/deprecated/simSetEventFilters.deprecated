name: sim.setEventFilters
description: Specifies filters for the sysCall_event callback. Operates on a per script basis
luaSynopsis: sim.setEventFilters(dict filters)
pythonSynopsis: sim.setEventFilters(map filters)
inputs:
1. filters: filters, e.g.: filters = {[objectHandle] = {'pose', 'jointPosition', 'layer'}, [sim.handle_scene] = {'engineProperties'}} filters = {[object1Handle] = {}, [object2Handle] = {'pose'}} filters = {[sim.handle_sceneobject] = {'pose'}}
outputs:
replacedBy:
- name: setEventFilters, class: detachedScript, file: detachedScript_setEventFilters.method
