name: sim.getFloatProperty
description: Fetches a float property (double)
luaSynopsis: float propertyState = sim.getFloatProperty(int target, string propertyName, dict options = {})
pythonSynopsis: float propertyState = sim.getFloatProperty(int target, string propertyName, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. options: an optional map. Set options.noError to true for silent errors
outputs:
1. propertyState: property value
replacedBy:
- name: getFloatProperty, class: object, file: object_getFloatProperty.method
