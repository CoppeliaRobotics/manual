name: sim.saveScene
description: Saves a scene. Any existing file with same name will be overwritten
luaSynopsis: bytes buffer = sim.saveScene(string filename = None)
pythonSynopsis: buffer buffer = sim.saveScene(string filename = nil)
inputs:
1. filename: scene filename. The filename extension is required. With None/nil, a buffer representing the serialized scene is returned
outputs:
1. buffer: if filename is None/nil, a buffer representing the serialized scene
replacedBy:
- name: save, class: scene, file: scene_save.method
- name: saveToBuffer, class: scene, file: scene_saveToBuffer.method
