name: sim.setObjectSel
description: Sets the object selection state
luaSynopsis: sim.setObjectSel(list objectHandles)
pythonSynopsis: sim.setObjectSel(int[] objectHandles)
inputs:
1. objectHandles: handles of objects to be selected
outputs:
replacedBy:
- name: selection, class: scene, file: scene_selection.property
- name: selected, class: sceneObject, file: sceneObject_selected.property
