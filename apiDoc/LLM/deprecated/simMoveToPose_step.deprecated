name: sim.moveToPose_step
description: Steps a motion object
luaSynopsis: int res, dict data = sim.moveToPose_step(dict motionObject)
pythonSynopsis: int res, table data = sim.moveToPose_step(table motionObject)
inputs:
1. motionObject: a motion object
outputs:
1. res: step result:
    - negative: error
    - 0: step successful, motion is still ongoing
    - 1: step successful, motion ended
    - 2: motion aborted
2. data: current motion state
replacedBy:
- name: step, class: MoveToPose, file: MoveToPose_step.method
