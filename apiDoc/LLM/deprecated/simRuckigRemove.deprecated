name: sim.ruckigRemove
description: Removes an object previously created via sim.ruckigPos or sim.ruckigVel.
luaSynopsis: sim.ruckigRemove(int handle)
pythonSynopsis: sim.ruckigRemove(int handle)
inputs:
1. handle: handle of the object created via sim.ruckigPos or sim.ruckigVel.
outputs:
replacedBy:
- name: remove, class: RuckigPosition, file: RuckigPosition_remove.method
- name: remove, class: RuckigVelocity, file: RuckigVelocity_remove.method
