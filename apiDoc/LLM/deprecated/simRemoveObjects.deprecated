name: sim.removeObjects
description: Removes one or several objects from the scene
luaSynopsis: sim.removeObjects(int[] objectHandles, bool delayedRemoval = False)
pythonSynopsis: sim.removeObjects(int[] objectHandles, bool delayedRemoval = false)
inputs:
1. objectHandles: handles of the objects to remove
2. delayedRemoval: whether the removal should be delayed (e.g. when a script destroys itself). Defaults to false
outputs:
replacedBy:
- name: removeObjects, class: app, file: app_removeObjects.method
- name: removeObjects, class: scene, file: scene_removeObjects.method
- name: remove, class: sceneObject, file: sceneObject_remove.method
