name: sim.setFloatArrayProperty
description: Sets a float array property (double[])
luaSynopsis: sim.setFloatArrayProperty(int target, string propertyName, list propertyState, dict options = {})
pythonSynopsis: sim.setFloatArrayProperty(int target, string propertyName, float[] propertyState, map options = {})
inputs:
1. target: target item
2. propertyName: property name
3. propertyState: property value
4. options: an optional map. Set options.noError to true for silent errors
outputs:
replacedBy:
- name: setFloatArrayProperty, class: object, file: object_setFloatArrayProperty.method
